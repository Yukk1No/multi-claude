#!/bin/zsh
# multi-claude for macOS - run several Claude Desktop accounts side by side.
# https://github.com/thomasog/multi-claude
#
# A profile is the official Claude.app started with its own --user-data-dir, so it keeps its own
# sign-in. `add` builds ~/Applications/Claude <name>.app: a tiny launcher whose icon is Claude's own
# icon, recolored with Core Image. No artwork ships with this tool.
set -euo pipefail

VERSION=0.1.0
HERE=${0:A:h}
CLAUDE_APP=/Applications/Claude.app
APPS=$HOME/Applications
BUNDLE_PREFIX=io.github.thomasog.multi-claude
NOT_FOUND="Claude Desktop was not found. Install it from https://claude.ai/download"
typeset -A PALETTE=(green 1F6F43 blue 1F4E8C purple 5B3A8E red 9B2C2C teal 146C6C pink A0346B gray 4A4F57)
COLORS=(green blue purple red teal pink gray)

USAGE="multi-claude $VERSION - several Claude Desktop accounts side by side

  multi-claude add <name> [--color <color>]   new profile: own sign-in and colored launcher
  multi-claude list                           installed profiles
  multi-claude open <name>                    open a profile
  multi-claude remove <name>                  remove a profile (its sign-in data is kept)
  multi-claude doctor                         check this Mac
  multi-claude uninstall                      remove multi-claude and every profile launcher

Colors: ${(j:, :)COLORS} or a hex value like C0392B"

fail()        { print -u2 -- "$1"; exit "${2:-1}"; }
data_dir()    { print -- "$HOME/Library/Application Support/Claude-$1"; }
launcher()    { print -- "$APPS/Claude $1.app"; }
is_running()  { pgrep -f -- "--user-data-dir=$(data_dir "$1")( |\$)" >/dev/null; }
check_name()  { [[ $1 =~ '^[A-Za-z0-9-]{1,24}$' ]] || fail "Profile name: letters, digits and dashes, up to 24 characters (e.g. Work)." 64; }
need_claude() { [[ -d $CLAUDE_APP ]] || fail "$NOT_FOUND"; }

profiles() {
  local app id
  for app in "$APPS"/Claude\ *.app(N); do
    id=$(/usr/libexec/PlistBuddy -c "Print :CFBundleIdentifier" "$app/Contents/Info.plist" 2>/dev/null) || continue
    if [[ $id == $BUNDLE_PREFIX.* ]]; then print -- "${id#$BUNDLE_PREFIX.}"; fi
  done
}

# An existing profile's spelling, so `open work` finds profile "Work".
canonical() {
  local n
  for n in ${(f)"$(profiles)"}; do
    if [[ ${n:l} == ${1:l} ]]; then print -- "$n"; return; fi
  done
  print -- "$1"
}

cmd_add() {
  local name=$1 color=$2 hex
  check_name "$name"
  hex=${PALETTE[${color:l}]:-${color#\#}}
  [[ $hex =~ '^[0-9A-Fa-f]{6}$' ]] || fail "Unknown color '$color'. Use ${(j:, :)COLORS} or a hex value like C0392B." 64
  need_claude

  local work; work=$(mktemp -d)
  trap "rm -rf '$work'" EXIT

  # Icon: Claude's installed icon -> PNG -> recolored -> .icns
  local icon_file source s
  icon_file=$(/usr/libexec/PlistBuddy -c "Print :CFBundleIconFile" "$CLAUDE_APP/Contents/Info.plist" 2>/dev/null) || icon_file=electron
  source="$CLAUDE_APP/Contents/Resources/${icon_file%.icns}.icns"
  [[ -f $source ]] || source=(${CLAUDE_APP}/Contents/Resources/*.icns(N[1]))
  [[ -f $source ]] || fail "Could not find Claude's icon in $CLAUDE_APP."
  sips -s format png -z 1024 1024 "$source" --out "$work/source.png" >/dev/null
  osascript -l JavaScript "$HERE/recolor.js" "$work/source.png" "$work/icon.png" "$hex"
  mkdir "$work/icon.iconset"
  for s in 16 32 128 256 512; do
    sips -z $s $s "$work/icon.png" --out "$work/icon.iconset/icon_${s}x${s}.png" >/dev/null
    sips -z $((s * 2)) $((s * 2)) "$work/icon.png" --out "$work/icon.iconset/icon_${s}x${s}@2x.png" >/dev/null
  done
  iconutil -c icns "$work/icon.iconset" -o "$work/icon.icns"

  # Launcher: opens the official Claude.app with this profile's own data folder.
  local app plist
  app=$(launcher "$name"); plist="$app/Contents/Info.plist"
  mkdir -p "$APPS"; rm -rf "$app"
  osacompile -o "$app" -e "do shell script \"open -n -a \" & quoted form of \"$CLAUDE_APP\" & \" --args --user-data-dir=\" & quoted form of \"$(data_dir "$name")\""
  cp "$work/icon.icns" "$app/Contents/Resources/applet.icns"
  /usr/libexec/PlistBuddy -c "Delete :CFBundleIconName" "$plist" 2>/dev/null || true   # it would override applet.icns
  rm -f "$app/Contents/Resources/Assets.car"
  /usr/libexec/PlistBuddy -c "Set :CFBundleIdentifier $BUNDLE_PREFIX.$name" "$plist"
  /usr/libexec/PlistBuddy -c "Set :CFBundleName Claude $name" "$plist" 2>/dev/null || true
  codesign --force -s - "$app" >/dev/null 2>&1 || true   # resources changed: re-sign ad hoc, locally
  touch "$app"

  print "
  Claude $name is ready: $app
  Drag it to the Dock. To sign in, choose \"Sign in with a code\". With single sign-on, quit the
  regular Claude first (Cmd+Q): the browser hands the login to whichever Claude is open."
}

cmd_list() {
  local -a names; names=(${(f)"$(profiles)"})
  (( $#names )) || { print "No profiles yet. Add one with: multi-claude add <name>"; return 0; }
  local n state
  for n in $names; do
    state=""; if is_running "$n"; then state=running; fi
    printf '%-16s %-8s %s\n' "$n" "$state" "$(data_dir "$n")"
  done
}

cmd_open() { check_name "$1"; need_claude; open -n -a "$CLAUDE_APP" --args --user-data-dir="$(data_dir "$1")"; }

cmd_remove() {
  check_name "$1"
  [[ -d $(launcher "$1") ]] || fail "No profile named '$1'."
  rm -rf "$(launcher "$1")"
  print "Removed Claude $1. Its sign-in data is kept in $(data_dir "$1") - delete that folder to sign out for good."
}

cmd_doctor() {
  local tool
  print "multi-claude $VERSION"
  if [[ -d $CLAUDE_APP ]]; then
    print "Claude Desktop:   $(defaults read "$CLAUDE_APP/Contents/Info.plist" CFBundleShortVersionString 2>/dev/null)"
  else
    print "Claude Desktop:   not found - https://claude.ai/download"
  fi
  for tool in sips iconutil osacompile osascript codesign; do
    if command -v $tool >/dev/null; then print "  $tool: ok"; else print "  $tool: missing"; fi
  done
  print
  cmd_list
}

cmd_uninstall() {
  local n link=$HOME/.local/bin/multi-claude
  for n in ${(f)"$(profiles)"}; do rm -rf "$(launcher "$n")"; done
  rm -rf "${XDG_DATA_HOME:-$HOME/.local/share}/multi-claude"
  if [[ -L $link && $(readlink "$link") == "${XDG_DATA_HOME:-$HOME/.local/share}/multi-claude/"* ]] || grep -qs '^# multi-claude for' "$link"; then
    rm -f "$link"
  fi
  print "multi-claude removed. Sign-in data is kept in ~/Library/Application Support/Claude-* - delete those folders to sign out for good."
}

# --- arguments ---------------------------------------------------------------------------------------
cmd="" name="" color=green
while (( $# )); do
  case $1 in
    -c|--color)   (( $# >= 2 )) || fail "--color needs a value." 64; color=$2; shift ;;
    -h|--help)    cmd=help ;;
    -v|--version) cmd=version ;;
    -*)           fail "Unknown option '$1'."$'\n\n'"$USAGE" 64 ;;
    *)
      if [[ -z $cmd ]]; then cmd=$1
      elif [[ -z $name ]]; then name=$1
      else fail "Unexpected argument '$1'."$'\n\n'"$USAGE" 64; fi ;;
  esac
  shift
done

case $cmd in
  add)       cmd_add "$name" "$color" ;;
  list)      cmd_list ;;
  open)      check_name "$name"; cmd_open "$(canonical "$name")" ;;
  remove)    check_name "$name"; cmd_remove "$(canonical "$name")" ;;
  doctor)    cmd_doctor ;;
  uninstall) cmd_uninstall ;;
  version)   print "multi-claude $VERSION" ;;
  help|"")   print -- "$USAGE" ;;
  *)         fail "Unknown command '$cmd'."$'\n\n'"$USAGE" 64 ;;
esac
